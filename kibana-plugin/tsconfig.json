{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "target",
    "rootDirs": ["public", "server"],
    "declaration": true
  },
  "include": ["public/**/*", "server/**/*"],
  "exclude": ["node_modules", "target"]
}
